msgstr "%(seller)s aceptó tu pedido y lo va a preparar para %(fulfillment)s."

#, python-format
msgid ""
"Your order with %(seller)s has been marked as completed. Enjoy your fresh"
" produce!"
msgstr ""
"Tu pedido con %(seller)s se marcó como completado. ¡Disfruta tus "
"productos frescos!"

