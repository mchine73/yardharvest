# Required in production
SECRET_KEY=generate-a-random-secret-key
JWT_SECRET_KEY=generate-a-different-random-key-for-jwt

# Database (Render sets this automatically with PostgreSQL addon)
DATABASE_URL=postgresql://user:pass@host:5432/yardharvest

# Email — Option 1: SendGrid (preferred, via Twilio)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yardharvest.com
SENDGRID_FROM_NAME=YardHarvest

# Email — Option 2: Zoho ZeptoMail transactional API (fallback if SendGrid not set)
# ZeptoMail is Zoho's transactional email service. Create a Mail Agent in the
# ZeptoMail console, verify the sending domain (SPF/DKIM DNS records), and copy
# its "Send Mail" token here. Auth is a send-only token — NOT a mailbox password.
# Set ZEPTOMAIL_API_URL to a regional host if your account isn't on .com
# (e.g. https://api.zeptomail.eu/v1.1/email).
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
ZEPTOMAIL_FROM_EMAIL=noreply@yardharvest.com
ZEPTOMAIL_FROM_NAME=YardHarvest

# Default From address shared by SendGrid + ZeptoMail when a provider-specific
# from address isn't set.
MAIL_DEFAULT_SENDER=noreply@yardharvest.com

# Stripe Payment (optional - uses dev mock if not set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS (comma-separated origins, defaults to localhost for dev)
CORS_ORIGINS=https://your-app.onrender.com


# Twilio SMS (optional - logs to console if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM marketing API token — used by the marketing_agent CLI to read audience
# segments and post draft campaigns to /crm/api/marketing/*. If unset, the API
# is disabled (returns 503).
MARKETING_API_KEY=