msgstr "No encontrado"

msgid "Less admin, more garden"
msgstr "Menos papeleo, más huerto"

#, python-format
msgid "Visit %(name)s"
msgstr "Visita %(name)s"

#, python-format
msgid "You received this email because you have an account on %(name)s."
msgstr "Recibiste este correo porque tienes una cuenta en %(name)s."

msgid "If you believe this was sent in error, please contact"
msgstr "Si crees que se envió por error, escribe a"

msgid "Password Reset Request"
msgstr "Solicitud para restablecer la contraseña"

#, python-format
msgid "Hi %(name)s,"
msgstr "Hola %(name)s:"

msgid ""
"We received a request to reset the password for your YardHarvest account."
" Click the button below to choose a new password:"
msgstr ""
"Recibimos una solicitud para restablecer la contraseña de tu cuenta de "
"YardHarvest. Usa el botón de abajo para elegir una nueva:"

msgid "Reset Your Password"
msgstr "Restablecer mi contraseña"

msgid ""
"This link expires in 1 hour and can only be used once. If you didn't "
"request a password reset, you can safely ignore this email."
msgstr ""
"El enlace vence en 1 hora y solo se puede usar una vez. Si no pediste "
"restablecer tu contraseña, puedes ignorar este correo."

