# Required in production
SECRET_KEY=generate-a-random-secret-key
JWT_SECRET_KEY=generate-a-different-random-key-for-jwt

# Database (Render sets this automatically with PostgreSQL addon)
DATABASE_URL=postgresql://user:pass@host:5432/yardharvest

# Email — Zoho ZeptoMail (sole provider; pay-as-you-go transactional API)
# Create a Mail Agent in the ZeptoMail console, verify the sending domain
# (SPF/DKIM DNS records), and copy its "Send Mail" token here. Auth is a
# send-only token — NOT a mailbox password. If unset, email is logged-only.
# Set ZEPTOMAIL_API_URL to a regional host if your account isn't on .com
# (e.g. https://api.zeptomail.eu/v1.1/email).
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.com/v1.1/email
# Must be an address on the domain you verified in ZeptoMail.
ZEPTOMAIL_FROM_EMAIL=james@yardharvest.app
ZEPTOMAIL_FROM_NAME=YardHarvest

# Default From address (used when ZEPTOMAIL_FROM_EMAIL isn't set).
MAIL_DEFAULT_SENDER=james@yardharvest.app

# Stripe Payment (optional - uses dev mock if not set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS (comma-separated origins, defaults to localhost for dev)
CORS_ORIGINS=https://your-app.onrender.com


# Twilio SMS (optional - logs to console if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM marketing API token — used by the marketing_agent CLI to read audience
# segments and post draft campaigns to /crm/api/marketing/*. If unset, the API
# is disabled (returns 503).
MARKETING_API_KEY=

# Cloudinary object storage for user-uploaded images (CDN, survives deploys).
# One value from your Cloudinary dashboard: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Unset = images saved to local disk (dev). Images always resolve via /media/<ref>.
CLOUDINARY_URL=

# Sentry error tracking (optional). Paste the DSN from your Sentry project.
# Unset = disabled (local dev). PII is not sent. Tune sampling if needed.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05