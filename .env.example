# Required in production
SECRET_KEY=generate-a-random-secret-key
JWT_SECRET_KEY=generate-a-different-random-key-for-jwt

# Database (Render sets this automatically with PostgreSQL addon)
DATABASE_URL=postgresql://user:pass@host:5432/yardharvest

# Email — Option 1: SendGrid (preferred, via Twilio)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=noreply@yardharvest.com
SENDGRID_FROM_NAME=YardHarvest

# Email — Option 2: Zoho Mail SMTP (fallback if SendGrid not set)
# Use an app-specific password generated in Zoho Mail account settings
# (Security → App Passwords) — never the primary account password.
# Default is STARTTLS on 587; use port 465 with MAIL_USE_SSL=true for SSL.
MAIL_SERVER=smtp.zoho.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=noreply@yardharvest.com

# Stripe Payment (optional - uses dev mock if not set)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# CORS (comma-separated origins, defaults to localhost for dev)
CORS_ORIGINS=https://your-app.onrender.com


# Twilio SMS (optional - logs to console if not set)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# CRM marketing API token — used by the marketing_agent CLI to read audience
# segments and post draft campaigns to /crm/api/marketing/*. If unset, the API
# is disabled (returns 503).
MARKETING_API_KEY=